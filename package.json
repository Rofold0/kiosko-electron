{
  "name": "kiosko",
  "productName": "Cuaderno de Vicios",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "postinstall": "electron-builder install-app-deps",
    "app:dir": "npm run build && electron-builder --dir",
    "app:dist": "npm run build && electron-builder",
    "license:keys": "node scripts/licensing/generarClaves.mjs",
    "license:create": "node scripts/licensing/generarLicencia.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.79.0",
    "vite": "^8.3.5",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "com.vicio.cuaderno",
    "productName": "Cuaderno de Vicios",
    "artifactName": "Cuaderno-de-Vicios-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}